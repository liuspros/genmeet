rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function code() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data.classCode; }
    match /users/{uid} { allow read: if request.auth != null && request.auth.uid == uid; }
    match /meetings/{id} { allow read: if request.auth != null && resource.data.classCode == code(); }
    match /groups/{g}/messages/{m} {
      allow read: if request.auth != null && g == code();
      allow create: if request.auth != null && g == code()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() < 2000;
    }
  }
}
